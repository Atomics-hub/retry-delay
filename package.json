{
  "name": "retry-delay",
  "version": "0.1.1",
  "type": "module",
  "description": "How long to wait before retrying, from a 429/503 response or SDK error: Retry-After (seconds or HTTP-date), retry-after-ms, OpenAI/Anthropic/GitHub/IETF rate-limit reset headers, Gemini RetryInfo and \"try again in 6.5s\" messages. Zero dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Tom Ryan",
  "keywords": [
    "retry-after",
    "retry-after-ms",
    "retry",
    "backoff",
    "rate-limit",
    "ratelimit",
    "429",
    "x-ratelimit-reset",
    "ratelimit-reset",
    "retryinfo",
    "openai",
    "anthropic",
    "gemini",
    "zero-dependency"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/api.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:pack": "node scripts/test-pack.mjs",
    "verify": "npm run build && npm test && npm run test:types && npm run test:pack",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/provider": "^4.0.36",
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^2.32.0",
    "ai": "^7.0.163",
    "axios": "^1.21.0",
    "openai": "^7.52.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atomics-hub/retry-delay.git"
  },
  "homepage": "https://github.com/Atomics-hub/retry-delay#readme",
  "bugs": {
    "url": "https://github.com/Atomics-hub/retry-delay/issues"
  }
}
